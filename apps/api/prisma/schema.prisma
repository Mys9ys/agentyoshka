generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Локальный тест без OSPanel Postgres: file:./dev.db (см. .env.example)
  // Прод / OSPanel позже: provider postgresql + migrate deploy
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Ник для входа (null = гость без пароля)
  handle       String?   @unique
  passwordHash String?
  isGuest      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  agent        Agent?
  sessions     Session[]
}

/// Opaque Bearer-токен. Хранится на клиенте в localStorage.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Agent {
  id             String       @id @default(cuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String       @default("Агентёшка")
  baseSkinId     String       @default("bear_cream")
  level          Int          @default(1)
  cultureXp      Int          @default(0)
  trainingGrade  String       @default("G0")
  cultureTrack   String       @default("neutral")
  coins          Int          @default(0)
  scenarioDayKey String       @default("monday")
  /// Сырые оси персонализации 0..1 (дисперсия); потолки — trainingGrade
  personalityJson Json?
  loginStreak              Int      @default(0)
  lastLoginDateKey         String?
  lastLoginClaimDateKey    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  dailyStates    DailyState[]
  loginClaims    DailyLoginClaim[]
  purchases      AgentPurchase[]
  replies        AgentReply[]
  productionRuns ProductionRun[]
}

model ProductionRun {
  id               String   @id @default(cuid())
  agentId          String
  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dateKey          String
  eventId          String
  weekday          String
  templateId       String
  title            String
  tagline          String
  baseCoinsPerHour Int
  baseBufferCap    Int
  bonusCoinsPerHour Int     @default(0)
  unclaimed        Int      @default(0)
  lastTickAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@unique([agentId, dateKey, eventId])
  @@index([agentId])
}

model AgentReply {
  id         String   @id @default(cuid())
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dateKey    String
  slotId     String
  text       String
  source     String
  regensUsed Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([agentId, dateKey, slotId])
  @@index([agentId, dateKey])
}

model DailyLoginClaim {
  id             String   @id @default(cuid())
  agentId        String
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dateKey        String
  streakDay      Int
  coinsGranted   Int
  hardwareDrop   String?
  createdAt      DateTime @default(now())

  @@unique([agentId, dateKey])
  @@index([agentId])
}

model AgentPurchase {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  itemId      String
  purchasedAt DateTime @default(now())

  @@unique([agentId, itemId])
  @@index([agentId])
}

/// Одно действие сценария за календарный день (урок, сбор и т.д.)
model DailyState {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  dateKey     String
  eventId     String
  choiceKey   String?
  completedAt DateTime @default(now())

  @@unique([agentId, dateKey, eventId])
  @@index([agentId, dateKey])
}
